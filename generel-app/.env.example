# Copy this file to .env and fill in values.
# For local dev: run `npx prisma dev` to get a local Postgres server + connection strings,
# then paste the DATABASE_URL / SHADOW_DATABASE_URL it prints below.

DATABASE_URL="postgres://postgres:postgres@localhost:51214/generel_app?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51214/generel_app_shadow?sslmode=disable"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
